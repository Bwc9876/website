---
import ProjectGrid from "@components/projects/ProjectGrid.astro";
import Layout from "@layouts/Layout.astro";
import cow from "@assets/cow.webp";
import { Image } from "astro:assets";
---

<Layout title="Ben C's Website" appendTitle={false}>
  <div class="hero">
    <div>
      <h1><span class="gradient-text">Ben C's</span> Website</h1>
      <p>Hello! My name is Ben and I'm a college student and software developer.</p>
      <p>
        I like to try a lot of things, from <a href="/projects/ow-new-horizons"> modding games</a>
        to building
        <a href="/projects/menagerie">websites</a> and
        <a href="/projects/ow-mod-man">desktop apps</a>. I really like programming, the web, and
        anything related to computers really!
      </p>
      <p>
        You can check out the <a href="/projects">projects</a> I've worked on or read my totally-alive
        <a href="/blog">blog</a>!
      </p>
      <p>Enjoy your stay 🐮</p>
    </div>
    <div class="hero-image">
      <Image width={150} height={150} format="webp" alt="Ben C's Avatar" src={cow} />
    </div>
  </div>

  <h2 id="about-me">About Me</h2>
  <div class="about-section">
    <p>
      I'm based in Pennsylvania, USA. I first started programming with Unity games but then quickly
      began doing web development and then expanded into anything I was interested in. I've been
      programming for about eight years now and hope that I can continue to pursue a career in this
      industry.
    </p>
    <p>
      I'm currently in college majoring in Computer Science. I'm hoping to graduate in 2027 with a
      Bachelors in Computer Science and a minor in Professional Technical Writing.
    </p>
  </div>

  <h2>Recent Projects</h2>
  <ProjectGrid limitTo={6} />
  <div class="view-more">
    <a href="/projects" role="button" class="secondary">View All Projects</a>
  </div>

  <style>
    .hero {
      display: flex;
      gap: var(--2);
      justify-content: space-between;
      flex-direction: column-reverse;
    }

    @media (width >= 1200px) {
      .hero {
        flex-direction: row;
        align-items: center;
      }
    }

    @keyframes glow {
      0% {
        box-shadow: 0 0 0 0 var(--primary);
      }
      100% {
        box-shadow: 0 0 450px 5px var(--primary);
      }
    }

    .hero-image {
      --anim-props: 900ms 500ms cubic-bezier(0.645, 0.045, 0.355, 1) 1 forwards;
      align-items: center;
      align-self: center;
      position: relative;
      animation: glow var(--anim-props);
      border-radius: 50%;
      box-sizing: border-box;
      margin: var(--10);
    }

    .hero-image img {
      width: var(--11);
      height: var(--11);
      position: relative;
      z-index: 100;
      clip-path: circle();
    }

    @keyframes pop {
      from {
        transform: scale(0);
      }
      to {
        transform: scale(1.8);
      }
    }

    .hero-image:after {
      animation: pop var(--anim-props);
      content: "";
      mask: url("/pfp-lines.svg") no-repeat 50% 50%;
      -webkit-mask: url("/pfp-lines.svg") no-repeat 50% 50%;
      -webkit-mask-size: cover;
      mask-size: cover;
      display: inline-block;
      position: absolute;
      inset: 0;
      width: 100%;
      background-image: radial-gradient(circle at center, var(--primary) 0, var(--accent) 100%);
    }

    .view-more {
      display: flex;
      justify-content: center;
      width: 100%;
      margin-top: var(--4);
    }

    .view-more a {
      width: 100%;
      text-align: center;
      font-weight: bold;
    }
  </style>
</Layout>
